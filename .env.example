# Copy to .env (or export these) to override the local defaults.
# VeriVault runs with sane defaults out of the box - none of this is required for local use.
VERIVAULT_SECRET_KEY=change-me-before-deploying
VERIVAULT_DEBUG=True
VERIVAULT_ALLOWED_HOSTS=localhost,127.0.0.1
VERIVAULT_SITE_URL=http://127.0.0.1:8000
VERIVAULT_HTTPS=False

# --- Deployment-only settings (leave unset for local use) -------------------
# Comma-separated list of extra origins allowed to submit forms (needed once
# DEBUG=False) - set this to your real https:// URL when deploying.
VERIVAULT_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# Points the database, media and document storage at a persistent disk's
# mount path, instead of the project folder. Required on any host (Render,
# Railway, Fly.io...) whose app filesystem is wiped on redeploy.
VERIVAULT_DATA_DIR=/var/data
# Set to "false" only if you're serving media (avatar images) from S3/R2/a
# CDN instead of directly from this app.
VERIVAULT_SERVE_MEDIA=true

